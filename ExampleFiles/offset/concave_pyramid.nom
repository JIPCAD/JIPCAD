###############  concave_pyramid.nom  ###############
### Demonstrates updated generators: 
### Merge, Subdivision, Offset, Normal Vectors
#####################################################

surface R color (1 0 0) endsurface     # Red
surface O color (0.9 0.6 0) endsurface # Orange
surface Y color (1 1 0) endsurface     # Yellow
surface L color (0.6 0.8 0) endsurface # Lime
surface G color (0 0.9 0) endsurface   # Green
surface A color (0 0.9 0.7) endsurface # Aqua
surface C color (0 1 1) endsurface     # Cyan
surface U color (0 0.5 1) endsurface   # Uniform
surface B color (0 0 1) endsurface     # Blue
surface P color (0.6 0 1) endsurface   # Purple
surface M color (1 0 1) endsurface     # Magenta
surface Z color (1 0 0.5) endsurface   # Zinnober

surface W color (1 1 1) endsurface       # White
surface D color (0.4 0.4 0.4) endsurface # Dark

### These may be referenced by the offset module:
surface oSurfOuter  color (0 0.9 0) endsurface   # Green
surface oSurfInner  color (0 0 1) endsurface     # Blue
surface oSurfEdges  color (1 0 0.5) endsurface   # Zinnober

###############  Scene parameter sliders ###############
bank p
  set tx         0    -0.5  0.5  0.1   ##  "shift peak in x"
  set ty         0    -0.5  0.5  0.1   ##  "shift peak in y"
  set tz         1     0    3    0.1   ##  "height of the pyramid tip"

  list ( tx ty tz )
endbank

###############  Pyramid Geometry  #####################################
mesh pyramid
  point vx  ( 2  0  0 ) endpoint
  point vy  ( 0  2  0 ) endpoint
  point va  (-2  0  0 ) endpoint
  point vb  ( 0 -2  0 ) endpoint
  point vc  (0.4 -0.4  0 ) endpoint
  point vz  ( {expr  $p.tx} {expr  $p.ty} {expr  $p.tz} ) endpoint

  face fxy (vz vx vy)  surface R  endface  ## pyr-faces
  face fya (vz vy va)  surface G  endface
  face fab (vz va vb)  surface B  endface
  face pf4 (vz vb vc)  surface M  endface
  face pf5 (vz vc vx)  surface Y  endface
endmesh

###### Uncomment the following sections one at a time to see the results

###### 1. Basic Pyramid Instance
### instance ipyramid pyramid endinstance

###### 2. In-code merge generator with color preservation
###### NOTE: Sliders do not work after merge
### merge merge_pyramid
###     instance ipyramid pyramid endinstance
### endmerge
### instance imerge_pyramid merge_pyramid endinstance

###### 3.1 Display Normal Vectors with Instance Generator
### merge merge_pyramid
###     instance ipyramid pyramid endinstance
### endmerge
### instance imerge_pyramid merge_pyramid facenormal 1.0 vertexnormal 0.5 endinstance

###### 3.2 In-code Normal Vector generator
### merge merge_pyramid
###     instance ipyramid pyramid endinstance
### endmerge
### instance imerge_pyramid merge_pyramid endinstance

### normals norm_pyramid vertexnormal 0.5
###   instance imerge_pyramid merge_pyramid  endinstance
### endnormals
### instance inorm_pyramid norm_pyramid endinstance

###### 4. In-code Subdivision Generator, with color preservation
### merge merge_pyramid
###     instance ipyramid pyramid  endinstance
### endmerge
### instance imerge_pyramid merge_pyramid endinstance

### subdivision subdiv_pyramid
###   sd_type NOME_SD_CC_sharp
###   sd_level 3 ### or use a custom variable such as {expr $p.varLevel}
###   instance imerge_pyramid merge_pyramid  endinstance
### endsubdivision
### instance isubdiv_pyramid subdiv_pyramid vertexnormal 0.5 endinstance

###### 5. In-code Offset Generator
merge merge_pyramid
    instance ipyramid pyramid  endinstance
endmerge
instance imerge_pyramid merge_pyramid vertexnormal 0.5 endinstance

offset offset_pyramid
    offset_type NOME_OFFSET_DEFAULT
    height 0.2 ### or use a custom variable such as {expr $p.varHeight}
    width 0.3  ### or use a custom variable such as {expr $p.varWidth}
    instance imerge_pyramid merge_pyramid endinstance
endoffset
instance ioffset_pyramid offset_pyramid endinstance
### instance ioffset_pyramid offset_pyramid vertexnormal 0.5 endinstance

###########################  END  ###############################
