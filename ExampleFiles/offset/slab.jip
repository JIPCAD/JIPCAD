################  offset_slab.jip  ##################
### Demostrates In-code Offset generator
### on a simple slab geometry
#####################################################

### Import Color Definitions
include :intro_imports\colors.jip endinclude

###############  Scene parameter sliders ###############
bank p
  set zbot      -1    -2    0    0.1   ##  "z-height of bot plate"

  list ( zbot )
endbank

###############  Slab Geometry  #####################################
mesh slab
  point bx  ( 2  0   {expr $p.zbot} ) endpoint
  point by  ( 0  2   {expr $p.zbot} ) endpoint
  point ba  (-2  0   {expr $p.zbot} ) endpoint
  point bb  ( 0 -2   {expr $p.zbot} ) endpoint

  face bottom (bx  by    ba  bb   )  surface G  endface
endmesh

###### Uncomment the following sections one at a time to see the results

###### 1. Basic Slab Instance
### instance islab slab  endinstance

###### 2. In-code Offset generator
###### NOTE: Sliders do not work after merge
merge merge_slab
    instance islab slab  endinstance
endmerge
instance imerge_slab merge_slab endinstance

offset offset_slab
    offset_type NOME_OFFSET_DEFAULT
    height 0.3
    hole 1.0
    instance imerge_slab merge_slab endinstance
endoffset
instance ioffset_slab offset_slab vertexnormal 1.0 endinstance

###########################  END  ###############################
